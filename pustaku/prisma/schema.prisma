generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Buku {
  id            Int    @id @default(autoincrement())
  judul         String
  penulis       String
  kategori      String
  tahunTerbit   Int
  stokTersedia  Int    @default(0)
  stokTotal     Int
  deskripsi     String
}
